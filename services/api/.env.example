# ==============================================================================
# WellSight AI — Asset Intelligence Copilot (.env.example)
# ==============================================================================

# Google Gemini / Gemma API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMMA_API_KEY=

# Model selection (gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemma-2-27b-it)
GEMINI_MODEL=gemini-2.5-flash

# Provider routing: 'auto', 'gemini', 'deterministic', 'openai'
AI_PROVIDER=auto

# Optional OpenAI key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database URL override (defaults to auto-managed SQLite with 600 wells)
# DATABASE_URL=sqlite:///./wellsight.db
