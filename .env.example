# WellSight AI Environment Configuration
# Hacktoberfest 2026 Asset Intelligence Copilot

# Database Configuration (Defaults to SQLite for local zero-dependency operation)
DATABASE_URL=sqlite:///./wellsight.db
# For PostgreSQL with pgvector in Docker:
# DATABASE_URL=postgresql://wellsight:wellsight_secure_pass@localhost:5432/wellsight_db

# AI Provider Configuration
# Supported providers: 'auto', 'deterministic', 'gemini', 'openai'
AI_PROVIDER=auto

# Google Gemini API Key (Optional: system works 100% offline via deterministic engine if absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
