# ==============================================================================
# WellSight AI — Root Environment Configuration Example (.env.example)
# ==============================================================================

# Google Gemini / Gemma API Key (Get your key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMMA_API_KEY=

# Preferred Gemini / Gemma model
GEMINI_MODEL=gemini-2.5-flash

# AI Provider Routing: 'auto', 'gemini', 'deterministic', 'openai'
AI_PROVIDER=auto

# Optional OpenAI key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (defaults to auto-managed SQLite with 600 wells)
DATABASE_URL=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
